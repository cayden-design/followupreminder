# Postgres — Railway injects this automatically once you attach the Postgres
# plugin to this service. Set it manually only for local runs.
DATABASE_URL=postgresql://user:pass@localhost:5432/followupreminder

# Password for the web form (HTTP basic auth; any username works).
# Required — the app refuses to serve the contact list without it.
APP_PASSWORD=

# Slack destination. Webhook is the simplest; bot token is used if both are set.
SLACK_WEBHOOK_URL=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789
# SLACK_CHANNEL=#followups

# Follow-up cadence and schedule.
FOLLOW_UP_MONTHS=3
CRON_WEEKLY_DIGEST=0 9 * * 1
TIMEZONE=America/New_York

# Post a "nothing due" message on quiet weeks instead of staying silent.
NOTIFY_WHEN_EMPTY=false

# Kill switch for the scheduler (leave true in production).
ENABLE_WEEKLY_DIGEST=true

# Run a missed digest on boot if this week's hasn't gone out yet.
CATCH_UP_ON_BOOT=true

# Used to link back to the app from the Slack digest. Railway sets
# RAILWAY_PUBLIC_DOMAIN for you, so this is usually unnecessary.
# PUBLIC_BASE_URL=https://followupreminder.up.railway.app
