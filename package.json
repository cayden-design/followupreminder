{
  "name": "followupreminder",
  "version": "1.0.0",
  "description": "Manual contact intake with a weekly Monday Slack digest of who is due for a 3-month follow-up",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/integration.ts",
    "digest:now": "tsx scripts/run-digest.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "reminders",
    "followup",
    "slack",
    "railway"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "pg-mem": "^3.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
